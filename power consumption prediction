      "source": [
        "def main():\n",
        "    df = print_dataset(URL)\n",
        "    data = make_features(df)\n",
        "    X_train, X_test, y_train, y_test = split_data(data)\n",
        "\n",
        "    pred_yesterday = X_test[\"load_yesterday\"].values\n",
        "    pred_persistence = X_test[\"load_now\"].values\n",
        "\n",
        "    lin = LinearRegression().fit(X_train, y_train)\n",
        "    pred_lin = lin.predict(X_test)\n",
        "\n",
        "    rf, _, _ = train_and_evalRFR(data)\n",
        "    pred_rf = rf.predict(X_test)\n",
        "\n",
        "    results = pd.DataFrame([\n",
        "        score(\"Baseline: same time yesterday\", y_test, pred_yesterday),\n",
        "        score(\"Baseline: persistence (load 1 hr ago)\", y_test, pred_persistence),\n",
        "        score(\"Linear Regression\", y_test, pred_lin),\n",
        "        score(\"Random Forest\", y_test, pred_rf),\n",
        "    ]).round(3)\n",
        "    print(results.to_string(index=False))\n",
        "\n",
        "    base_mae_value = results.loc[0, \"MAE\"]\n",
        "    for i in (2, 3):\n",
        "        gain = 100 * (base_mae_value - results.loc[i, \"MAE\"]) / base_mae_value\n",
        "        print(f\"{results.loc[i, 'Model']}: {gain:.1f}% lower MAE than \"\n",
        "              f\"'yesterday' baseline\")\n",
        "\n",
        "    results.to_csv(\"rung1_comparison_table.csv\", index=False)\n",
        "\n",
        "\n",
        "    importances = plot_results(y_test, X_test, pred_rf, rf, pred_lin, lin)\n",
        "    print(\"\\nFeature importances:\")\n",
        "    print(importances.round(4))\n",
        "\n",
        "    joblib.dump(rf, MODEL)\n",
        "    print(f\"\\nSaved Random Forest to {MODEL}\")\n",
        "main()"
