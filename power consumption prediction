        " df = df.set_index(\"DateTime\").sort_index()\n",
        "\n",
        " from sklearn.svm import SVR\n",
        " from sklearn.preprocessing import StandardScaler\n",
        "\n",
        " SUBSAMPLE = None\n",
        "\n",
        " df[\"Hour\"] = df.index.hour\n",
        " df[\"Month\"] = df.index.month\n",
        "\n",
        " df[\"lag_10min\"] = df[powerconsumption].shift(1)\n",
        " df[\"lag_1hr\"]   = df[powerconsumption].shift(6)\n",
        " df[\"lag_1day\"]  = df[powerconsumption].shift(144)\n",
        " df = df.dropna()\n",
        "\n",
        " time = [\"Hour\", \"Month\",\n",
        "                 \"lag_10min\", \"lag_1hr\", \"lag_1day\"]\n",
        "\n",
        " X = df[time]\n",
        " y = df[powerconsumption]\n",
        " split_idx = int(len(df) * 0.8)\n",
        "\n",
        " X_train, X_test = X.iloc[:split_idx], X.iloc[split_idx:]\n",
        " y_train, y_test = y.iloc[:split_idx], y.iloc[split_idx:]\n",
        " if SUBSAMPLE is not None:\n",
        "    X_train, y_train = X_train.iloc[-SUBSAMPLE:], y_train.iloc[-SUBSAMPLE:]\n",
        "\n",
        " x_scaler = StandardScaler()\n",
        " X_train_s = x_scaler.fit_transform(X_train)\n",
        " X_test_s = x_scaler.transform(X_test)\n",
        "\n",
        " y_scaler = StandardScaler()\n",
        " y_train_s = y_scaler.fit_transform(y_train.values.reshape(-1, 1)).ravel()\n",
        "\n",
        "\n",
        " model = SVR(kernel=\"rbf\", C=10, epsilon=0.05, gamma=\"scale\")\n",
        " model.fit(X_train_s, y_train_s)\n",
        "\n",
        " y_pred_s = model.predict(X_test_s)\n",
        " y_pred = y_scaler.inverse_transform(y_pred_s.reshape(-1, 1)).ravel()\n",
        "\n",
        " mae = mean_absolute_error(y_test, y_pred)\n",
