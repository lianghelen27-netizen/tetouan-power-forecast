        "def plot_results(y_test, X_test, pred_rf, rf, pred_lin, lin, path=\"rung1_figure.png\"):\n",
        "    week_start = y_test.index[0] + pd.Timedelta(days=7)\n",
        "    week_end = week_start + pd.Timedelta(days=7)\n",
        "    mask = (y_test.index >= week_start) & (y_test.index < week_end)\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(18, 5),\n",
        "                             gridspec_kw={\"width_ratios\": [2.2, 1]})\n",
        "\n",
        "    ax = axes[0]\n",
        "    ax.plot(y_test.index[mask], y_test.values[mask],\n",
        "            label=\"Actual\", color=\"black\")\n",
        "    ax.plot(y_test.index[mask], X_test[\"load_yesterday\"].values[mask],\n",
        "            label=\"Baseline: yesterday\", alpha=0.6, linestyle=\"--\")\n",
        "    ax.plot(y_test.index[mask], pred_rf[mask],\n",
        "            label=\"Random Forest\", alpha=0.85)\n",
        "    ax.plot(y_test.index[mask], pred_lin[mask],\n",
        "            label=\"Linear Regresson\", alpha=0.85)\n",
        "    ax.set_title(\"One week, 1-hour-ahead forecast (test period)\")\n",
        "    ax.set_xlabel(\"DateTime\")\n",
        "    ax.set_ylabel(powerconsumption)\n",
        "    ax.legend()\n",
        "\n",
        "    imp = pd.Series(rf.feature_importances_,\n",
        "                    index=Times).sort_values()\n",
        "    axes[1].barh(imp.index, imp.values)\n",
        "    axes[1].set_title(\"Random Forest feature importances\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(path, dpi=150)\n",
        "    plt.show()\n",
        "    return imp.sort_values(ascending=False)\n",
        "\n",
        "X_train, X_test, y_train, y_test = split_data(Data)\n",
        "rf, _, _ = train_and_evalRFR(Data)\n",
        "pred_rf = rf.predict(X_test)\n",
        "lin, _, _ = train_and_evalLR(Data)\n",
        "pred_lin = lin.predict(X_test)\n",
        "plot_results(y_test, X_test, pred_rf, rf, pred_lin, lin, path=\"rung1_figure.png\")\n"
