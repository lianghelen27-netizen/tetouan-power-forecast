    {
      "cell_type": "code",
      "source": [
        "\n",
        "def make_features(df):\n",
        "    load = df[powerconsumption]\n",
        "    out = pd.DataFrame({\"target\": load})\n",
        "\n",
        "    out[\"Hour\"] = out.index.hour\n",
        "    out[\"DayOfWeek\"] = out.index.dayofweek\n",
        "    out[\"Month\"] = out.index.month\n",
        "\n",
        "    out[\"load_now\"] = load.shift(6)\n",
        "    out[\"load_now_minus_10m\"] = load.shift(7)\n",
        "    out[\"load_now_minus_1hr\"] = load.shift(12)\n",
